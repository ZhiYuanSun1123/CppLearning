{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "demo",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-fsanitize=address",
                "-fno-omit-frame-pointer",
                "${file}",
                "-o",
                "${fileDirname}/../target/${fileBasenameNoExtension}",
                "-I",
                "${fileDirname}/../include"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}